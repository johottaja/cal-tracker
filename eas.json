{
  "cli": {
    "version": ">= 24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "channel": "testflight"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822363285"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6822363285"
      }
    }
  }
}
